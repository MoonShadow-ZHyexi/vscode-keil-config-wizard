{
  "name": "keil-config-wizard",
  "displayName": "Keil 文本配置向导",
  "description": "通过表单编辑带 Keil Configuration Wizard 注释的源文件",
  "publisher": "local-tools",
  "version": "0.5.32",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MoonShadow-ZHyexi/keil-config-wizard.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onWebviewPanel:keilWizard",
    "onStartupFinished"
  ],
  "files": [
    "extension.js",
    "configuration.js",
    "editor-associations.js",
    "wizard-webview-client.js",
    "wizard-webview.js",
    "wizard-panel.js",
    "integer-literals.js",
    "example.h",
    "README.md",
    "CONFIGURATION_WIZARD_RULES.md",
    "LICENSE"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "keilWizard.editor",
        "displayName": "Keil 配置向导",
        "selector": [{ "filenamePattern": "*" }],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "keilWizard.convertCurrent",
        "title": "切换到 Keil 配置向导",
        "icon": "$(settings-gear)"
      },
      {
        "command": "keilWizard.returnToText",
        "title": "切换到文本编辑器",
        "icon": "$(code)"
      },
      {
        "title": "打开 Keil 配置向导",
        "command": "keilWizard.open"
      },
      {
        "title": "打开大纲",
        "command": "keilWizard.showOutline"
      },
      {
        "title": "关闭大纲",
        "command": "keilWizard.hideOutline"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "keilWizard.convertCurrent",
          "when": "resource in keilWizard.convertibleResources && !activeCustomEditorId",
          "group": "navigation"
        },
        {
          "command": "keilWizard.returnToText",
          "when": "activeCustomEditorId == keilWizard.editor || (resourceScheme == webview-panel && keilWizard.legacyWizardActive && (!activeWebviewPanelId || activeWebviewPanelId == keilWizard))",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "keilWizard.convertCurrent",
          "when": "false"
        },
        {
          "command": "keilWizard.returnToText",
          "when": "false"
        },
        {
          "command": "keilWizard.showOutline",
          "when": "false"
        },
        {
          "command": "keilWizard.hideOutline",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "keilWizard.showOutline",
          "when": "keilWizardPanel && !keilWizardOutlineVisible",
          "group": "navigation"
        },
        {
          "command": "keilWizard.hideOutline",
          "when": "keilWizardPanel && keilWizardOutlineVisible",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "group": "navigation",
          "command": "keilWizard.open"
        }
      ]
    }
  }
}
